generator client {
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  BOARD
  DEVELOPER
  BLOXXS_TEAM
  ORIGINADOR
  DISTRIBUIDOR
  ASSESSOR
  INVESTIDOR
}

enum InviteStatus {
  PENDENTE
  ACEITO
  EXPIRADO
}

// ============================================
// AUTH & EQUIPE (colunas camelCase — sem @map individual)
// ============================================

model TeamGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("team_groups")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      UserRole @default(INVESTIDOR)
  name      String?
  avatar    String?

  groupId   String?
  group     TeamGroup? @relation(fields: [groupId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserInvite {
  id        String       @id @default(cuid())
  email     String
  role      UserRole     @default(BLOXXS_TEAM)
  groupId   String?
  token     String       @unique
  status    InviteStatus @default(PENDENTE)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("user_invites")
}

// ============================================
// PRODUTO — ROADMAP & SPRINTS
// ============================================

model Epic {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  stream      String   @default("Plataforma Core")
  status      String   @default("planned")
  priority    String   @default("medium")
  color       String   @default("blue")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // P&L fields (028_pnl_fields.sql)
  fixedCostEstimado   Decimal?  @default(0) @map("fixed_cost_estimado")  @db.Decimal(14, 2)
  receitaDesbloqueada Decimal?  @default(0) @map("receita_desbloqueada") @db.Decimal(14, 2)
  airEstimado         Decimal?  @default(0) @map("air_estimado")         @db.Decimal(5, 2)
  tipoCustoDominante  String?   @map("tipo_custo_dominante")
  moatClassificacao   String?   @map("moat_classificacao")
  tipoProduto         String?   @map("tipo_produto")
  clientesVinculados  String[]  @default([]) @map("clientes_vinculados")
  riceScore           Decimal?  @default(0) @map("rice_score")           @db.Decimal(8, 2)

  sprints     Sprint[]
  gateChecks  EpicGateCheck[]

  @@map("epics")
}

model Sprint {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  goal       String?
  status     String    @default("planning")
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  velocity   Int?      @default(0)
  epicId     String?   @map("epic_id") @db.Uuid
  epic       Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // P&L fields (028_pnl_fields.sql)
  kpiNegocioAlvo String?  @map("kpi_negocio_alvo")
  temAiCogs      Boolean  @default(false) @map("tem_ai_cogs")

  tasks         Task[]
  sprint_reviews SprintReview?

  @@map("sprints")
}

model Task {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  status       String    @default("todo")
  priority     String?   @default("medium")
  storyPoints  Int?      @default(1) @map("story_points")
  epic         String?
  assignee     String?
  sprintId     String?   @map("sprint_id") @db.Uuid
  sprint       Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentTaskId String?   @map("parent_task_id") @db.Uuid
  parent       Task?     @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]    @relation("TaskSubtasks")
  position     Int?      @default(0)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // P&L fields (028_pnl_fields.sql)
  aiCogsEstimado Decimal? @default(0) @map("ai_cogs_estimado") @db.Decimal(12, 2)

  @@index([sprintId])
  @@map("tasks")
}

model SprintReview {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sprintId  String    @unique @map("sprint_id") @db.Uuid
  theme     String?
  blockers  String[]  @default([])
  learnings String[]  @default([])
  highlights Json?    @default("[]")
  nextTheme String?   @map("next_theme")
  nextItems String[]  @default([]) @map("next_items")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // P&L fields (028_pnl_fields.sql)
  fixedCostRealizado Decimal? @default(0) @map("fixed_cost_realizado") @db.Decimal(14, 2)
  receitaRealizada   Decimal? @default(0) @map("receita_realizada")    @db.Decimal(14, 2)
  aiCogsRealizado    Decimal? @default(0) @map("ai_cogs_realizado")    @db.Decimal(14, 2)

  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@map("sprint_reviews")
}

model BacklogItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  description    String?
  moscowPriority String   @default("could") @map("moscow_priority")
  storyPoints    Int      @default(1) @map("story_points")
  businessValue  Int      @default(3) @map("business_value")
  epic           String?
  status         String   @default("open")
  assignee       String?
  sprintId       String?  @map("sprint_id") @db.Uuid
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("backlog_items")
}

// ============================================
// PRODUTO — OKRs
// ============================================

model Objective {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  quarter     String
  status      String    @default("on_track")
  owner       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  keyResults  KeyResult[]

  @@map("objectives")
}

model KeyResult {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  objectiveId     String    @map("objective_id") @db.Uuid
  objective       Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  targetValue     Decimal   @default(100) @map("target_value")
  currentValue    Decimal   @default(0) @map("current_value")
  unit            String    @default("%")
  status          String    @default("on_track")
  dashboardMetric String?   @map("dashboard_metric")
  owner           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkins  Checkin[]

  @@map("key_results")
}

model Checkin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyResultId  String   @map("key_result_id") @db.Uuid
  keyResult    KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  value        Decimal
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("checkins")
}

// ============================================
// PRODUTO — RELEASES
// ============================================

model Release {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     String   @unique
  summary     String?
  visibility  String   @default("internal")
  sprintName  String?  @map("sprint_name")
  releasedAt  DateTime @default(now()) @map("released_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  changelog   ChangelogItem[]

  @@map("releases")
}

model ChangelogItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseId   String   @map("release_id") @db.Uuid
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  type        String   @default("feature")
  title       String
  description String?
  taskId      String?  @map("task_id")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("changelog_items")
}

// ============================================
// PRODUTO — FEATURE FLAGS
// ============================================

model FeatureFlag {
  id               String   @id @default(cuid())
  key              String   @unique
  label            String
  description      String?
  type             String   @default("release")
  isDev            Boolean  @default(false) @map("is_dev")
  isStaging        Boolean  @default(false) @map("is_staging")
  isProd           Boolean  @default(false) @map("is_prod")
  rollout          Int      @default(0)
  segments         String[]
  lastModified     DateTime @default(now()) @map("last_modified") @db.Timestamptz(6)
  modifiedBy       String?  @map("modified_by")
  modifiedInitials String?  @map("modified_initials")
  modifiedColor    String?  @map("modified_color")
  linkedEpic       String?  @map("linked_epic")
  epicColor        String?  @map("epic_color")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  audits FlagAudit[]

  @@map("feature_flags")
}

model FlagAudit {
  id            String      @id @default(cuid())
  flagId        String      @map("flag_id")
  flag          FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  action        String
  environment   String?
  previousValue String?     @map("previous_value")
  newValue      String?     @map("new_value")
  userId        String?     @map("user_id")
  userName      String?     @map("user_name")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([flagId])
  @@map("flag_audit_logs")
}

// ============================================
// PRODUTO — P&L / GATE CHECKS (029_pnl_gate_checks.sql)
// ============================================

model EpicGateCheck {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  epicId        String    @map("epic_id") @db.Uuid
  gateCode      String    @map("gate_code")
  status        String    @default("pending")
  computedValue Decimal?  @map("computed_value")
  note          String?
  checkedAt     DateTime  @default(now()) @map("checked_at") @db.Timestamptz(6)

  epic          Epic      @relation(fields: [epicId], references: [id], onDelete: Cascade)

  @@index([epicId], name: "idx_gate_checks_epic")
  @@map("epic_gate_checks")
}

// ============================================
// PRODUTO — DECISÕES (ADR)
// ============================================

model Decision {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adrNumber    Int      @default(autoincrement()) @map("adr_number")
  title        String
  status       String   @default("open")
  category     String   @default("produto")
  decidedBy    String?  @map("decided_by")
  participants String[] @default([])
  context      String?
  decision     String?
  rationale    String?
  alternatives Json?    @default("[]")
  consequences String?
  epicLink     String?  @map("epic_link")
  tags         String[] @default([])
  decidedAt    DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("decisions")
}

// ============================================
// PRODUTO — OBSERVABILIDADE
// ============================================

model Incident {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  severity      String   @default("medium")
  status        String   @default("active")
  affectedUsers Int      @default(0) @map("affected_users")
  affectedPct   Decimal? @map("affected_pct")
  components    String[] @default([])
  rootCause     String?  @map("root_cause")
  sprintTaskId  String?  @map("sprint_task_id")
  timeline      Json?    @default("[]")
  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("incidents")
}

model ServiceCheck {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceName String   @unique @map("service_name")
  status      String   @default("operational")
  latencyMs   Int?     @default(0) @map("latency_ms")
  uptimePct   Decimal? @default(100) @map("uptime_pct")
  icon        String?  @default("Globe")
  notes       String?
  checkedAt   DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("service_checks")
}

model Bug {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  severity   String   @default("medium")
  status     String   @default("open")
  sprintId   String?  @map("sprint_id") @db.Uuid
  epicId     String?  @map("epic_id") @db.Uuid
  assignee   String?
  reportedAt DateTime @default(now()) @map("reported_at") @db.Date
  resolvedAt DateTime? @map("resolved_at") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bugs")
}

// ============================================
// PRODUTO — DISCOVERY
// ============================================

model Research {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  type         String   @default("interview")
  status       String   @default("planned")
  objective    String?
  participants Int      @default(0)
  owner        String?
  epicId       String?  @map("epic_id") @db.Uuid
  tags         String[] @default([])
  researchDate DateTime @default(now()) @map("research_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  insights     Insight[]

  @@map("researches")
}

model Insight {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote      String
  type       String   @default("behavior")
  severity   String   @default("medium")
  researchId String?  @map("research_id") @db.Uuid
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)
  epicId     String?  @map("epic_id") @db.Uuid
  tags       String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("insights")
}

// ============================================
// PRODUTO — FEEDBACK & NPS
// ============================================

model FeedbackEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote        String
  sentiment    String   @default("neutral")
  category     String   @default("Geral")
  source       String   @default("Web")
  score        Int?
  epicId       String?  @map("epic_id") @db.Uuid
  sprintId     String?  @map("sprint_id") @db.Uuid
  feedbackDate DateTime @default(now()) @map("feedback_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("feedback_entries")
}

model NpsMonthly {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  month          String   @unique
  score          Decimal
  totalResponses Int      @default(0) @map("total_responses")
  promoters      Int      @default(0)
  neutrals       Int      @default(0)
  detractors     Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("nps_monthly")
}

// ============================================
// PRODUTO — COMPETITIVE INTELLIGENCE
// ============================================

model Competitor {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  shortName       String   @map("short_name")
  color           String   @default("bg-gray-100 text-gray-800")
  threat          String   @default("médio")
  differentiation String?
  users           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  moves           CompetitiveMove[]

  @@map("competitors")
}

model CompetitiveFeature {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feature      String
  category     String   @default("Plataforma")
  bloxs        String   @default("unavailable")
  availability Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("competitive_features")
}

model CompetitiveMove {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitorId String     @map("competitor_id") @db.Uuid
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  type         String     @default("feature")
  description  String
  impact       String     @default("médio")
  moveDate     String     @map("move_date")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("competitive_moves")
}
